# TrendPulse
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# X API app-only bearer token. Leave empty to serve the cached demo snapshot.
# Recent search is queued and capped; the app never calls X from a page view.
X_BEARER_TOKEN=

# Optional OpenAI-compatible model. Without a key, ideas are drafted locally from the snapshot.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Encrypts WhatsApp numbers and authenticator secrets. A local key file is created if this is empty.
TRENDPULSE_ENC_KEY=

# Optional email alerts via Resend.
RESEND_API_KEY=
RESEND_FROM=

# Set to true to enqueue ingestion every 15 minutes inside the Node server.
ENABLE_INGEST_SCHEDULER=false

# Development login hints are on unless this is false. They never appear in production.
DEMO_LOGIN=true
